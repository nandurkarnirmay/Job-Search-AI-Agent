# The browser calls same-origin /api/*; next.config.mjs forwards to the backend(s).
# Single backend (local dev, or SERVICE=all on one host):
API_URL=http://localhost:8000
# Microservices (Vercel → Project Settings → Environment Variables), each overrides API_URL for its paths:
# AUTH_SERVICE_URL=https://job-agent-auth.onrender.com
# JOBS_SERVICE_URL=https://job-agent-jobs.onrender.com
# RESUME_SERVICE_URL=https://job-agent-resume.onrender.com
# INTERVIEW_SERVICE_URL=https://job-agent-interview.onrender.com
# Optional: call a backend directly instead of through the gateway
# NEXT_PUBLIC_API_URL=
