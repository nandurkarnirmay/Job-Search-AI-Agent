# Copy to backend/.env for local development. Never commit the real file.
ENV=development
DATABASE_URL=postgresql+psycopg://jobagent:jobagent@localhost:5432/jobagent
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
FRONTEND_ORIGINS=http://localhost:3000

# LLM (https://aistudio.google.com/app/apikey). Without a key the agent uses a rule-based parser.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Job sources (at least one is required for real results)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=

# Comma-separated emails allowed to see /stats/search
ADMIN_EMAILS=

# Optional error tracking (https://sentry.io)
SENTRY_DSN=

# Abuse protection: requests per minute per client on search/chat
RATE_LIMIT_PER_MINUTE=30
SEARCH_CACHE_TTL_SECONDS=900

# Week 3
WIKIPEDIA_ENABLED=true
AUTO_MIGRATE=true
COMPANY_CACHE_TTL_SECONDS=21600
MAX_ALERTS_PER_USER=5

# Week 4: alert emails over SMTP (leave SMTP_HOST empty = alerts are kept in-app only)
# Brevo: smtp-relay.brevo.com:587 · Gmail: smtp.gmail.com:587 with an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# Shared secret for POST /internal/alerts/dispatch (GitHub Actions cron). Empty disables the endpoint.
CRON_TOKEN=
