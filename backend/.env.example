# Copy to backend/.env for local development. Never commit the real file.
ENV=development
DATABASE_URL=sqlite:///./dev.db
REDIS_URL=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
FRONTEND_ORIGINS=http://localhost:3000

# LLM (https://aistudio.google.com/app/apikey). Without a key the agent uses a rule-based parser.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Job sources (at least one is required for real results)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=

# Comma-separated emails allowed to see /stats/search
ADMIN_EMAILS=

# Optional error tracking (https://sentry.io)
SENTRY_DSN=

# Abuse protection: requests per minute per client on search/chat
RATE_LIMIT_PER_MINUTE=30
SEARCH_CACHE_TTL_SECONDS=900

# Week 3
WIKIPEDIA_ENABLED=true
AUTO_MIGRATE=true
COMPANY_CACHE_TTL_SECONDS=21600
MAX_ALERTS_PER_USER=5

# Week 4: alert emails over SMTP (leave SMTP_HOST empty = alerts are kept in-app only)
# Brevo: smtp-relay.brevo.com:587 · Gmail: smtp.gmail.com:587 with an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# Shared secret for POST /internal/alerts/dispatch (GitHub Actions cron). Empty disables the endpoint.
CRON_TOKEN=

# Week 5: fallback job source + GitHub profile analysis
JOOBLE_API_KEY=
FALLBACK_MIN_RESULTS=10
STALE_CACHE_TTL_SECONDS=86400
# Fine-grained token with no permissions (public data only). Empty = 60 requests/hour.
GITHUB_TOKEN=

# Week 7: security
# Encrypts chat, resume text, notes and interview answers. Comma-separated: first encrypts, all decrypt (rotation).
# REQUIRED in production. Losing it makes that data unreadable: keep an offline copy.
FIELD_ENCRYPTION_KEYS=dev-only-change-me
# If set, /metrics requires the X-Metrics-Token header
METRICS_TOKEN=
# all | auth | jobs | resume | interview
SERVICE=all
RETENTION_DAYS_CHATS=180
RETENTION_DAYS_SEARCH_LOGS=90
