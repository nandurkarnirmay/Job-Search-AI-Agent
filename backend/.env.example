# Copy to backend/.env for local development. Never commit the real file.
ENV=development
DATABASE_URL=postgresql+psycopg://jobagent:jobagent@localhost:5432/jobagent
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
FRONTEND_ORIGINS=http://localhost:3000

# LLM (https://aistudio.google.com/app/apikey). Without a key the agent uses a rule-based parser.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Job sources (at least one is required for real results)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=

# Comma-separated emails allowed to see /stats/search
ADMIN_EMAILS=

# Optional error tracking (https://sentry.io)
SENTRY_DSN=

# Abuse protection: requests per minute per client on search/chat
RATE_LIMIT_PER_MINUTE=30
SEARCH_CACHE_TTL_SECONDS=900
